# Nyvexa backend environment
# Copy this file to `.env` and fill in your key from https://openrouter.ai/keys

# --- Model providers (all free tiers available) ---
# NVIDIA NIM (free tier): https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# OpenRouter (free :free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

NYVEXA_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b
NYVEXA_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NYVEXA_RATE_LIMIT=20
NYVEXA_RESEARCH_MAX_QUERIES=4
NYVEXA_RESEARCH_RESULTS=4
NYVEXA_DEEP_ROUNDS=3
NYVEXA_CORS_ORIGINS=*

# --- Auth (everyone must log in with email/password or Google) ---
# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
# The redirect URI is derived from the request origin automatically — register
# every host you serve from as an authorized redirect URI, e.g.:
#   http://localhost:8300/api/auth/google/callback
#   https://your-public-host.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the redirect URI instead of deriving it per-request
# GOOGLE_REDIRECT_URI=http://localhost:8300/api/auth/google/callback

# Optional: data directory for SQLite (users, conversations, knowledge base)
# NYVEXA_DATA_DIR=/app/data

# Optional: Redis URL for multi-instance rate limiting
# REDIS_URL=redis://localhost:6379/0
